[
	// ============================================================
	// 窗口与视图管理 (Window & View Management)
	// ============================================================
	{
		"key": "alt+q",
		"command": "workbench.action.toggleSidebarVisibility",
	},
	{
		"key": "ctrl+\\",
		"command": "workbench.action.terminal.toggleTerminal",
	},
	// 标签页切换 (Option+-)
	{
		"key": "alt+=",
		"command": "workbench.action.nextEditor",
	},
	{
		"key": "alt+-",
		"command": "workbench.action.previousEditor",
	},
	{
		"key": "cmd+n",
		"command": "welcome.showNewFileEntries",
	},
	// ============================================================
	// 代码导航 (Code Navigation)
	// ============================================================
	{
		"key": "cmd+f12",
		"command": "-editor.action.revealDefinition",
		"when": "editorHasDefinitionProvider && editorTextFocus && isWeb",
	},
	{
		"key": "cmd+f12",
		"command": "-editor.action.goToImplementation",
		"when": "editorHasDefinitionProvider && editorTextFocus",
	},
	{
		"key": "cmd+f12",
		"command": "workbench.profiles.actions.exportProfile",
	},
	// 错误/警告跳转
	{
		"key": "cmd+1",
		"command": "editor.action.marker.nextInFiles",
		"when": "editorFocus",
	},
	// ============================================================
	// 代码编辑 (Code Editing)
	// ============================================================
	{
		"key": "cmd+alt+r",
		"command": "workbench.action.files.revert",
		"when": "editorTextFocus"
	},
	{
		"key": "cmd+2",
		"command": "editor.action.formatDocument",
		"when": "editorHasDocumentFormattingProvider && editorTextFocus && !editorReadonly && !inCompositeEditor",
	},
	{
		"key": "shift+alt+f",
		"command": "-editor.action.formatDocument",
		"when": "editorHasDocumentFormattingProvider && editorTextFocus && !editorReadonly && !inCompositeEditor",
	},
	{
		"key": "cmd+r",
		"command": "editor.action.startFindReplaceAction",
		"when": "editorFocus || editorIsOpen",
	},
	{
		"key": "alt+cmd+f",
		"command": "-editor.action.startFindReplaceAction",
		"when": "editorFocus || editorIsOpen",
	},
	{
		"key": "shift+cmd+h",
		"command": "-workbench.action.replaceInFiles",
	},
	// 行复制 (Ctrl+Shift+D)
	{
		"key": "ctrl+shift+d",
		"command": "editor.action.copyLinesDownAction",
		"when": "editorTextFocus && !editorReadonly",
	},
	// 逐次添加相同单词选择 (Cmd+D)
	{
		"key": "cmd+d",
		"command": "editor.action.addSelectionToNextFindMatch",
		"when": "editorTextFocus && !editorReadonly",
	},
	// 行移动 (Alt+J/K)
	{
		"key": "alt+j",
		"command": "editor.action.moveLinesDownAction",
		"when": "vim.mode != 'Insert' && editorTextFocus",
	},
	{
		"key": "alt+k",
		"command": "editor.action.moveLinesUpAction",
		"when": "vim.mode != 'Insert' && editorTextFocus",
	},
	// ============================================================
	// Vim 模拟 (基于 .ideavimrc)
	// ============================================================
	// 空格 --> 冒号
	{
		"key": "space",
		"command": "type",
		"args": {
			"text": ":"
		},
		"when": "vim.mode == 'Normal' && editorTextFocus && !editorHasMultipleSelections && !editorReadonly"
	},
	// 取消查找高亮
	{
		"key": "space h",
		"command": "vim.remap",
		"when": "vim.mode == 'Normal' && editorTextFocus",
		"args": {
			"after": [
				":nohlsearch",
				"<CR>"
			]
		}
	},
	// Option+H/L 行首行尾
	{
		"key": "alt+h",
		"command": "vim.remap",
		"when": "vim.mode == 'Normal'",
		"args": {
			"after": [
				"^"
			]
		}
	},
	{
		"key": "alt+l",
		"command": "vim.remap",
		"when": "vim.mode == 'Normal'",
		"args": {
			"after": [
				"$"
			]
		}
	},
	// Ctrl+K/J 翻半屏
	{
		"key": "ctrl+k",
		"command": "vim.remap",
		"when": "vim.mode == 'Normal'",
		"args": {
			"after": [
				"<C-u>"
			]
		}
	},
	{
		"key": "ctrl+j",
		"command": "vim.remap",
		"when": "vim.mode == 'Normal'",
		"args": {
			"after": [
				"<C-d>"
			]
		}
	},
	// Insert 模式 Option+D 删除当前行
	{
		"key": "alt+d",
		"command": "vim.remap",
		"when": "vim.mode == 'Insert'",
		"args": {
			"after": [
				"<Esc>",
				"c",
				"c"
			]
		}
	},
	// Normal 模式 Option+Z 居中
	{
		"key": "alt+z",
		"command": "vim.remap",
		"when": "vim.mode == 'Normal'",
		"args": {
			"after": [
				"G",
				"z",
				"z"
			]
		}
	},
	// Option+V Visual Block
	{
		"key": "alt+v",
		"command": "vim.remap",
		"args": {
			"after": [
				"<C-v>"
			]
		}
	},
	{
		"key": "alt+v",
		"command": "-editor.action.clipboardPasteAction",
	},
	// Ctrl+D Normal 模式清空当前行
	{
		"key": "ctrl+d",
		"command": "vim.remap",
		"when": "vim.mode == 'Normal' && editorTextFocus",
		"args": {
			"after": [
				"<Esc>",
				"c",
				"c"
			]
		}
	},
	// Ctrl+D Insert 模式删除行
	{
		"key": "ctrl+d",
		"command": "vim.remap",
		"when": "vim.mode == 'Insert'",
		"args": {
			"after": [
				"<Esc>",
				"c",
				"c"
			]
		}
	},
	// v模式移动行首行尾
	{
		"key": "alt+h",
		"command": "vim.remap",
		"when": "vim.mode == 'Visual'",
		"args": {
			"after": [
				"v",
				"^"
			]
		}
	},
	{
		"key": "alt+l",
		"command": "vim.remap",
		"when": "vim.mode == 'Visual'",
		"args": {
			"after": [
				"v",
				"$"
			]
		}
	},
	// ============================================================
	// 智能运行文件 (Smart File Runner - Cmd+3)
	// ============================================================
	{
		"key": "cmd+3",
		"command": "extension.liveServer.goOnline",
		"when": "editorLangId == html && editorTextFocus",
	},
		{
			"key": "cmd+3",
			"command": "runCommands",
			"args": {
				"commands": [
					"workbench.action.terminal.focus",
					"workbench.action.terminal.clear",
					"python.execInTerminal"
				]
			},
			"when": "editorLangId == python && editorTextFocus",
		},
		{
			"key": "cmd+3",
			"command": "code-runner.run",
			"when": "editorLangId =~ /^(javascript|typescript|c|cpp)$/ && editorTextFocus",
		},
	// ============================================================
	// 其他
	// ============================================================
	{
		"key": "delete",
		"command": "deleteRight",
		"when": "textInputFocus",
	},
	{
		"key": "ctrl+d",
		"command": "-deleteRight",
		"when": "textInputFocus",
	},
	{
		"key": "ctrl+[Backslash]",
		"command": "workbench.action.terminal.toggleTerminal",
		"when": "terminal.active",
	},
	// ============================================================
	// 补全接受分离 (Completion Accept Split)
	// Supermaven 灰字补全 -> 回车接受；VS Code 原生补全弹窗 -> Tab 接受
	// ============================================================
	// 1. 回车接受 Supermaven 灰字补全（仅当没有弹出 IntelliSense 建议框时）
	{
		"key": "enter",
		"command": "editor.action.inlineSuggest.commit",
		"when": "inlineSuggestionVisible && !suggestWidgetVisible && !editorReadonly",
	},
	// 2. 解绑 Tab 对 Supermaven 灰字补全的接受，Tab 只留给原生补全弹窗
	{
		"key": "tab",
		"command": "-editor.action.inlineSuggest.commit",
		"when": "inlineSuggestionVisible && !editorTabMovesFocus && !suggestWidgetVisible",
	},
	{
		"key": "cmd+2",
		"command": "-workbench.action.focusSecondEditorGroup"
	},
	// Vim Normal 模式 Cmd+I 直接触发 EasyMotion 全屏字符跳转
	{
		"key": "cmd+i",
		"command": "vim.remap",
		"when": "vim.mode == 'Normal' && editorTextFocus",
		"args": {
			"after": [
				"<leader>",
				"<leader>",
				"s"
			]
		}
	},
	{
		"key": "cmd+a",
		"command": "-extension.vim_cmd+a",
		"when": "editorTextFocus && vim.active && vim.use<D-a> && !inDebugRepl && vim.mode != 'Insert'"
	}
]