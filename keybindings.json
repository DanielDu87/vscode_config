[
	// ============================================================
	// 窗口与视图管理 (Window & View Management)
	// ============================================================
	{
		"key": "alt+q",
		"command": "workbench.action.toggleSidebarVisibility",
	},
	{
		"key": "ctrl+\\",
		"command": "workbench.action.terminal.toggleTerminal",
	},
	// 标签页切换 (Option+-)
	{
		"key": "alt+=",
		"command": "workbench.action.nextEditor",
	},
	{
		"key": "alt+-",
		"command": "workbench.action.previousEditor",
	},
	{
		"key": "cmd+n",
		"command": "welcome.showNewFileEntries",
	},
	// ============================================================
	// 代码导航 (Code Navigation)
	// ============================================================
	{
		"key": "cmd+f12",
		"command": "-editor.action.revealDefinition",
		"when": "editorHasDefinitionProvider && editorTextFocus && isWeb",
	},
	{
		"key": "cmd+f12",
		"command": "-editor.action.goToImplementation",
		"when": "editorHasDefinitionProvider && editorTextFocus",
	},
	{
		"key": "cmd+f12",
		"command": "workbench.profiles.actions.exportProfile",
	},
	// AceJump / FindThenJump 快速跳转
	{
		"key": "cmd+i",
		"command": "extension.aceJump",
	},
	{
		"key": "cmd+i",
		"command": "findThenJump.initiate",
	},
	// 错误/警告跳转
	{
		"key": "cmd+1",
		"command": "editor.action.marker.nextInFiles",
		"when": "editorFocus",
	},
	// ============================================================
	// 代码编辑 (Code Editing)
	// ============================================================
	{
		"key": "cmd+2",
		"command": "editor.action.formatDocument",
		"when": "editorHasDocumentFormattingProvider && editorTextFocus && !editorReadonly && !inCompositeEditor",
	},
	{
		"key": "shift+alt+f",
		"command": "-editor.action.formatDocument",
		"when": "editorHasDocumentFormattingProvider && editorTextFocus && !editorReadonly && !inCompositeEditor",
	},
	{
		"key": "cmd+r",
		"command": "editor.action.startFindReplaceAction",
		"when": "editorFocus || editorIsOpen",
	},
	{
		"key": "alt+cmd+f",
		"command": "-editor.action.startFindReplaceAction",
		"when": "editorFocus || editorIsOpen",
	},
	{
		"key": "shift+cmd+h",
		"command": "-workbench.action.replaceInFiles",
	},
	// 行复制 (Cmd+D)
	{
		"key": "cmd+d",
		"command": "editor.action.copyLinesDownAction",
		"when": "editorTextFocus && !editorReadonly",
	},
	// 行移动 (Alt+J/K)
	{
		"key": "alt+j",
		"command": "editor.action.moveLinesDownAction",
		"when": "vim.mode != 'Insert' && editorTextFocus",
	},
	{
		"key": "alt+k",
		"command": "editor.action.moveLinesUpAction",
		"when": "vim.mode != 'Insert' && editorTextFocus",
	},
	// ============================================================
	// Vim 模拟 (基于 .ideavimrc)
	// ============================================================
	// 空格 --> 冒号
	{
		"key": "space",
		"command": "type",
		"args": { "text": ":" },
		"when": "vim.mode == 'Normal' && editorTextFocus && !editorHasMultipleSelections && !editorReadonly"
	},
	// 取消查找高亮
	{
		"key": "space h",
		"command": "vim.remap",
		"when": "vim.mode == 'Normal' && editorTextFocus",
		"args": { "after": [":nohlsearch", "<CR>"] }
	},
	// Option+H/L 行首行尾
	{
		"key": "alt+h",
		"command": "vim.remap",
		"when": "vim.mode == 'Normal'",
		"args": { "after": ["^"] }
	},
	{
		"key": "alt+l",
		"command": "vim.remap",
		"when": "vim.mode == 'Normal'",
		"args": { "after": ["$"] }
	},
	// Ctrl+K/J 翻半屏
	{
		"key": "ctrl+k",
		"command": "vim.remap",
		"when": "vim.mode == 'Normal'",
		"args": { "after": ["<C-u>"] }
	},
	{
		"key": "ctrl+j",
		"command": "vim.remap",
		"when": "vim.mode == 'Normal'",
		"args": { "after": ["<C-d>"] }
	},
	// Insert 模式 Option+D 删除当前行
	{
		"key": "alt+d",
		"command": "vim.remap",
		"when": "vim.mode == 'Insert'",
		"args": { "after": ["<Esc>", "c", "c"] }
	},
	// Normal 模式 Option+Z 居中
	{
		"key": "alt+z",
		"command": "vim.remap",
		"when": "vim.mode == 'Normal'",
		"args": { "after": ["G", "z", "z"] }
	},
	// Option+V Visual Block
	{
		"key": "alt+v",
		"command": "vim.remap",
		"args": { "after": ["<C-v>"] }
	},
	{
		"key": "alt+v",
		"command": "-editor.action.clipboardPasteAction",
	},
	// Ctrl+D Normal 模式多光标
	{
		"key": "ctrl+d",
		"command": "editor.action.addSelectionToNextFindMatch",
		"when": "vim.mode == 'Normal' && editorTextFocus",
	},
	// Ctrl+D Insert 模式删除行
	{
		"key": "ctrl+d",
		"command": "vim.remap",
		"when": "vim.mode == 'Insert'",
		"args": { "after": ["<Esc>", "c", "c"] }
	},
	// 自定义文本对象 (引号)
	// ciq/cq - 修改引号内
	{
		"key": "q",
		"command": "vim.remap",
		"when": "vim.mode == 'Normal' && editorTextFocus",
		"args": {
			"before": ["c", "i", "q"],
			"after": ["c", "i", "\""]
		}
	},
	// v模式移动行首行尾
	{
		"key": "alt+h",
		"command": "vim.remap",
		"when": "vim.mode == 'Visual'",
		"args": { "after": ["v", "^"] }
	},
	{
		"key": "alt+l",
		"command": "vim.remap",
		"when": "vim.mode == 'Visual'",
		"args": { "after": ["v", "$"] }
	},
	// ============================================================
	// 智能运行文件 (Smart File Runner - Cmd+3)
	// ============================================================
	{
		"key": "cmd+3",
		"command": "extension.liveServer.goOnline",
		"when": "editorLangId == html && editorTextFocus",
	},
	{
		"key": "cmd+3",
		"command": "code-runner.run",
		"when": "editorLangId == python && editorTextFocus",
	},
	{
		"key": "cmd+3",
		"command": "code-runner.run",
		"when": "editorLangId == javascript && editorTextFocus",
	},
	{
		"key": "cmd+3",
		"command": "code-runner.run",
		"when": "editorLangId == typescript && editorTextFocus",
	},
	{
		"key": "cmd+3",
		"command": "code-runner.run",
		"when": "editorLangId == c && editorTextFocus",
	},
	{
		"key": "cmd+3",
		"command": "code-runner.run",
		"when": "editorLangId == cpp && editorTextFocus",
	},
	// ============================================================
	// 其他
	// ============================================================
	{
		"key": "delete",
		"command": "deleteRight",
		"when": "textInputFocus",
	},
	{
		"key": "ctrl+d",
		"command": "-deleteRight",
		"when": "textInputFocus",
	},
	{
		"key": "ctrl+[Backslash]",
		"command": "workbench.action.terminal.toggleTerminal",
		"when": "terminal.active",
	}
]
