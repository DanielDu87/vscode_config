{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Remove Extra Blank Lines",
			"type": "process",
			"command": "/opt/homebrew/bin/python3",
			"args": [
				"/Users/dyx/Library/Application Support/Code/User/.vscode/remove_blank_lines.py",
				"${file}"
			],
			"problemMatcher": [],
			"presentation": {
				"reveal": "never",
				"close": true
			}
		},
		{
			"label": "运行当前 Python 文件（zshrc 环境）",
			"type": "process",
			"command": "/Users/dyx/.local/bin/python-run",
			"args": [
				"${file}"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true,
				"showReuseMessage": false,
				"close": false
			}
		}
	]
}
